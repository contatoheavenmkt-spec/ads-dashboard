{
  "name": "ads-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "seed": "ts-node --project tsconfig.json prisma/seed.ts",
    "db:seed": "npx tsx prisma/seed.ts",
    "worker": "node --import tsx worker/index.ts",
    "track:check": "tsx scripts/track-check.ts && tsx scripts/track-check-funil.ts && tsx scripts/track-check-mensagem.ts && tsx scripts/track-check-rules.ts && tsx scripts/track-check-dispatch.ts && tsx scripts/track-check-contatos.ts && tsx scripts/track-check-meta.ts",
    "track:e2e": "tsx scripts/track-e2e.ts && tsx scripts/track-check-claim.ts",
    "ai:check": "tsx scripts/ai-check-regras.ts"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.1",
    "@libsql/client": "^0.17.2",
    "@number-flow/react": "^0.6.0",
